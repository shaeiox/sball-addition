[Unit]
Description=sball-addition quorate watcher
Documentation=man:sball-addition(8)
# No After=/Wants=/Requires= on sballd.service, on purpose: this project must
# never start, stop or restart the PVM service. The watcher polls the PVM
# socket and follows whatever the daemon does - it does not drive it. (A
# "Wants=sballd.service" here would make systemd start the daemon whenever the
# watcher starts, which is exactly what we promise never to do.)
After=network.target
ConditionPathExists=/usr/bin/sball-addition

[Service]
Type=simple
EnvironmentFile=-/etc/sysconfig/sball-addition
ExecStart=/usr/bin/sball-addition watcher --foreground
# The watcher exits 1 when it cannot reach quorate before
# post-quorate.poll_timeout_seconds; systemd then retries with a fresh poll
# window, which also covers daemon restarts done by the operator.
Restart=on-failure
RestartSec=5
# The watcher kills hook process groups on stop, so give it a moment.
KillMode=mixed
TimeoutStopSec=30
# The watcher only needs to reach the local PVM socket and write state/runtime
# files; it does not need to spawn VMs itself.
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
