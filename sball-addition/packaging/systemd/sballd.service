# Reference copy of the PVM service unit as shipped by CloudAvid. It exists so
# that you can see what the daemon looks like; sball-addition never installs it,
# never overwrites it and never edits it.
#
# If (and only if) an administrator decides that the pre-quorate hooks should run
# at every start, "sball-integration apply" writes the drop-in
# /etc/systemd/system/sballd.service.d/sball-addition.conf, which overrides
# ExecStart for the next start without touching this vendor file.
[Unit]
Description=sballd - PVM cluster service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/sysconfig/sball
ExecStart=/usr/sbin/sballd
Restart=on-failure
RestartSec=5
KillMode=process
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
